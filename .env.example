# =====================================================================
#  ORTAM DEĞİŞKENLERİ – ÖRNEK DOSYA
# ---------------------------------------------------------------------
#  BU DOSYAYI ELLE DOLDURMANIZA GEREK YOK: "kurulum/" klasöründeki
#  sihirbazı çalıştırın, ".env" dosyasını sizin için üretir.
#
#  Elle kurulum yapıyorsanız bu dosyayı ".env" adıyla kopyalayın.
#  ".env" dosyası .gitignore içindedir; asla depoya gönderilmez.
#
#  Kodun okuduğu HER anahtar burada yazar. "#" ile başlayan anahtarlar
#  isteğe bağlıdır; yazılan değer, satır hiç yokken kullanılan
#  varsayılandır.
#
#  ÖZEL KARAKTERLİ DEĞERLER (boşluk, #, ", $, \) çift tırnak içinde
#  yazılır; tırnak içinde \" \\ \$ \n kaçışları geçerlidir.
#      DB_PASS="Pa\$\$w0rd#1"
# =====================================================================

APP_NAME=Transkript
APP_DESCRIPTION="YouTube ve ses/video kayıtlarından zaman damgalı transcript ve AI analizi"
#  Sitenin tam adresi, sonda / olmadan (ör. https://transkript.ornek.com ya da
#  yerelde http://localhost/transcript-system).
APP_URL=

# --- Ortam ----------------------------------------------------------
#  APP_ENV: local | production   (kendi bilgisayarınızda: local + true)
#  Varsayılan YAYIN modudur: satır hiç yoksa production + debug kapalı
#  kabul edilir. Yalnızca kendi bilgisayarınızda local + true yapın.
#  İkisi çelişirse (production + debug) güvenlik kanalına uyarı düşer;
#  debug açık site yerel bir adresten açılmıyorsa panelin her
#  sayfasında kırmızı uyarı çıkar.
APP_ENV=production
APP_DEBUG=false

#  DEMO MODU — yalnızca herkese açık deneme siteleri için. Açıkken
#  giriş ekranı örnek hesapları (Yönetici, Editör, Üye; parola
#  Demo1234!) tek tıkla giriş için listeler; bu hesaplara hesap,
#  kullanıcı, ayar, sistem ve e-posta işlemleri kapanır. Örnek
#  hesaplar kurulumdaki "Örnek verileri de yükle" ile gelir. Kurulumda
#  açtığınız yönetici hesabı kısıtlanmaz. Gerçek bir sitede false.
APP_DEMO=false

#  Kuruluma özel gizli anahtar (64 onaltılık karakter). Oturumları,
#  "beni hatırla" ve güvenilen cihaz çerezlerini, e-posta doğrulama
#  bağlantılarını ve form zaman damgalarını bu kuruluma bağlar.
#  Doluyken kurulum kimliği YALNIZCA bundan türetilir (klasör yolundan
#  değil); her dağıtımı yeni klasöre açan araçlarda oturumlar düşmez.
#  Başka bir kuruluma KOPYALAMAYIN. Üretmek için:
#      php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

APP_PRETTY_URLS=true
APP_TIMEZONE=Europe/Istanbul

# --- Veritabanı (utf8mb4_turkish_ci) --------------------------------
#  XAMPP'ta varsayılan: root, parola boş. Yayında ayrı bir kullanıcı açın.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=transcript_system
DB_USER=root
DB_PASS=

# --- Oturum ---------------------------------------------------------
#  SESSION_NAME: Çerez adı — aynı alan adında birden fazla kurulum
#  varsa her biri FARKLI olmalı (yalnızca harf, rakam, _). Boşsa
#  kuruluma özel bir ad üretilir.
#  SESSION_PATH: Oturum dosyalarının klasörü. Satır yoksa
#  storage/sessions kullanılır; "SESSION_PATH=" (boş) PHP'nin sistem
#  klasörüne döner. Sunucu oturumları Redis/Memcached'de tutuyorsa
#  (session.save_handler) bu ayar zaten yok sayılır.
#  SESSION_REGENERATE: oturum kimliği kaç saniyede bir yenilensin.
SESSION_NAME=
SESSION_IDLE_TIMEOUT=1800
# SESSION_PATH=
# SESSION_REGENERATE=900

# --- Giriş ve kayıt koruması ----------------------------------------
#  LOGIN_MAX_ATTEMPTS / LOGIN_LOCKOUT: aynı kimliğe, aynı IP'den (ya da
#  aynı güvenilen cihazdan) bu kadar hatalı denemede bu kadar saniye
#  kilit. LOGIN_WINDOW: denemelerin sayıldığı pencere (saniye).
#
#  LOGIN_IP_MAX_ATTEMPTS: tek IP'den bu kadar FARKLI kimlik denenince
#  giderek artan bekleme başlar (1, 2, 4… saniye; en fazla
#  LOGIN_LOCKOUT). IPv6 /64 bloğu tek adres sayılır. Daha önce bu
#  hesaba giriş yapmış tarayıcı bu yavaşlatmaya takılmaz. 0 → kapalı.
#
#  REGISTER_MAX_PER_HOUR: bir IP'den saatte en fazla kaç yeni hesap.
#  REGISTER_MAX_ATTEMPTS_PER_HOUR: kayıt formuna saatte en fazla kaç
#  GÖNDERİM (hatalılar dahil).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT=900
# LOGIN_WINDOW=900
LOGIN_IP_MAX_ATTEMPTS=30
REGISTER_MAX_PER_HOUR=5
REGISTER_MAX_ATTEMPTS_PER_HOUR=20

# --- Güvenilen vekiller ---------------------------------------------
#  Site Cloudflare, yük dengeleyici ya da ters vekil (nginx) arkasındaysa
#  vekillerin adreslerini/aralıklarını yazın. Yazılmazsa bütün
#  ziyaretçiler vekilin IP'sinden geliyor görünür: tek bir saldırgan
#  giriş yavaşlatmasını HERKES için tetikler.
#  Başlık yalnızca istek listedeki bir vekilden geldiyse okunur.
#      TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
#      TRUSTED_PROXY_HEADER=CF-Connecting-IP      (Cloudflare için)
TRUSTED_PROXIES=
# TRUSTED_PROXY_HEADER=X-Forwarded-For

# --- REST API / mobil uygulama oturumu ------------------------------
#  Mobil uygulamanın parolayla aldığı oturum anahtarı kaç gün geçerli.
API_SESSION_DAYS=30

# --- Yüklemeler -----------------------------------------------------
#  UPLOAD_MAX_PIXELS: genişlik × yükseklik sınırı ("görsel bombası").
UPLOAD_MAX_MB=2
UPLOAD_MAX_PIXELS=25000000

# --- REST API (/api/v1/…) -------------------------------------------
#  Anahtar (ya da IP) başına pencerede en fazla kaç istek.
# API_RATE_LIMIT=120
# API_RATE_WINDOW=60

# --- İş kuyruğu (php cy queue:work) ---------------------------------
#  QUEUE_TIMEOUT: bu kadar saniyedir "çalışıyor"da duran iş, işçisi
#  çökmüş sayılıp yeniden kuyruğa alınır (hakkı bittiyse başarısız).
#  QUEUE_MAX_JOBS: işçi bir çalıştırmada en fazla kaç iş yapsın.
#  Transkript: bir yapay zekâ adımı birkaç dakika sürebilir, yedek
#  sağlayıcıya geçiş de eklenir; 900 önerilir (varsayılan 300 kısa kalır).
QUEUE_TIMEOUT=900
# QUEUE_MAX_JOBS=25

# --- Olaylar --------------------------------------------------------
#  Açıkken bir dinleyicinin hatası fırlatılır (geliştirmede yararlı);
#  kapalıyken log'a yazılıp devam edilir. Varsayılan: APP_DEBUG.
# EVENTS_STRICT=false

# --- İçerik Güvenliği Politikası (CSP) ------------------------------
#  Politikayı KAPATMAYIN; bir dış servis engellenirse yalnızca onun
#  adresini ekleyin (birden fazlası virgülle).
# CSP_ENABLED=true
# CSP_SCRIPT_SRC=https://js.stripe.com
# CSP_STYLE_SRC=
# CSP_IMG_SRC=
# CSP_CONNECT_SRC=
# CSP_FRAME_SRC=https://js.stripe.com
# CSP_FONT_SRC=

# --- Günlük kayıtları (storage/logs) --------------------------------
#  LOG_LEVEL: debug | info | warning | error | critical
#  Eşiğin ALTINDAKİ kayıtlar hiç yazılmaz. Yayında "info", geliştirirken "debug".
LOG_ENABLED=true
LOG_LEVEL=info
LOG_DAYS=30

# --- Önbellek -------------------------------------------------------
#  CACHE_DRIVER: dosya | veritabani | kapali
#    dosya       storage/cache/data (varsayılan, kurulum gerektirmez)
#    veritabani  "onbellek" tablosu — çok sunuculu kurulumlar için
#    kapali      hiçbir şey saklamaz (hata ararken işe yarar)
#  Hız sınırları önbellekte DEĞİL, storage/cache/hiz altındaki kilitli
#  dosyalarda tutulur; önbelleği kapatmak onları etkilemez.
#
#  CACHE_PREFIX: Aynı klasörü/veritabanını paylaşan projeler
#  birbirinin verisini okumasın diye her projeye kendi öneğini verin.
CACHE_DRIVER=dosya
CACHE_TTL=3600
CACHE_PREFIX=cy

# --- Transkript modülü: YouTube -----------------------------------
#  YOUTUBE_API_KEY: YouTube Data API v3 (video süresi, tarihi, gizlilik).
#  Boşsa oEmbed yedeği kullanılır: başlık, kanal ve görsel gelir; süre
#  ve tarih gelmez, gömmeye kapalı herkese açık video "gizli" görünür.
#  Anahtar: console.cloud.google.com → YouTube Data API v3 (ücretsiz kota).
YOUTUBE_API_KEY=

# --- Transkript modülü: yapay zekâ sağlayıcıları (yedek zinciri) ----
#  Anahtarı "=" işaretinin sağına yapıştırın; başka bir şey yapmanız
#  gerekmez. Anahtarlar YALNIZCA burada durur; koda, veritabanına, log'a,
#  API yanıtına ve sayfaya yazılmaz (panel yalnız "tanımlı / tanımsız"
#  gösterir). Boş bırakılan sağlayıcı atlanır.
#
#  AI_PROVIDERS deneme sırasıdır: ilki asıl sağlayıcı. Kotası dolan ya da
#  hata veren bir süre dinlenir, iş sıradakiyle sürer; hepsi dinlenirken
#  iş hata vermez, en erken açılışta kaldığı yerden devam eder.
#  Durum: Panel → Transkript → Transkript ayarları → Durum.
#  Kullanılabilecek adlar: evren · gemini · openrouter · groq · mistral ·
#  cerebras · claude · openai-compatible. Önerilen (hepsi ücretsiz):
#  AI_PROVIDER: asıl sağlayıcı (AI_MODEL / AI_API_KEY onundur); boşsa evren.
AI_PROVIDER=evren
AI_PROVIDERS=evren,gemini,openrouter,groq

#  EVREN (SSYZ, yurt içi) — 1 Kasım 2026'ya kadar ücretsiz, günlük 15M token.
#  Anahtar evren.ssyz.org.tr'den; LLM anahtarı "evren_llm_" ile başlar
#  ("evren_" ile başlayan platform anahtarı çalışmaz). Kullanım şartlarını
#  ilk çağrıdan önce bir kez Transkript ayarları → Durum → "Şartları oku ve
#  onayla" ile onaylayın (kod kendiliğinden onaylamaz). Teşhis:
#  php modules/Transkript/bin/evren-teshis.php
#  EVREN_BASE_URL boşsa https://evren-llmapi.ssyz.org.tr/v1
#  EVREN_MODEL boşsa glm-5.3 (panelden de seçilir: Transkript ayarları → Yapay zekâ)
EVREN_API_KEY=
EVREN_BASE_URL=
EVREN_MODEL=
#  İsteğe bağlı EVREN ayarları (boşsa parantezdeki varsayılan; docs/evren):
#   EVREN_STREAM        akışlı yanıt (SSE): true | false  (true)
#   EVREN_BOSTA_SN      akışta bu kadar sn hiç token gelmezse istek kesilir (60)
#   EVREN_ILK_TOKEN_SN  ilk token'a kadar en çok (kuyrukta bekleyiş; keep-alive
#                       gelirken). Hiç bayt gelmezse 30 sn'de kesilir (120)
#   EVREN_TOPLAM_SN     bir isteğin toplam süre sınırı; boşsa giriş boyutuyla
#                       ölçeklenir: 120 sn + 40 token/sn, en çok 900
#   EVREN_THINKING      düşünme: off | low | default  (low)
#   EVREN_JSON_SCHEMA   yanıt biçimi json_schema (strict): true | false  (true)
#   EVREN_YEDEK_MODEL   asıl EVREN modeli zaman aşımı / düşünme bütçesi / 503
#                       verince başka sağlayıcıdan önce denenen hızlı EVREN
#                       modeli; "yok" kapatır  (gemma-4-31b)
#   EVREN_LIVE_TESTS    1 ise tests/evren-canli.php gerçek EVREN'e gider (0)
# EVREN_STREAM=
# EVREN_BOSTA_SN=
# EVREN_ILK_TOKEN_SN=
# EVREN_TOPLAM_SN=
# EVREN_THINKING=
# EVREN_JSON_SCHEMA=
# EVREN_YEDEK_MODEL=

#  Google Gemini — ücretsiz katman (günlük kota) · https://aistudio.google.com/apikey
GEMINI_API_KEY=

#  OpenRouter — ":free" ile biten modeller ücretsiz · https://openrouter.ai/keys
OPENROUTER_API_KEY=

#  Groq — ücretsiz katman (dakikalık sınırı düşük, bu yüzden sonda) · https://console.groq.com/keys
GROQ_API_KEY=

#  Mistral · https://console.mistral.ai/api-keys   Cerebras · https://cloud.cerebras.ai
#  (AI_PROVIDERS'a eklenmedikçe kullanılmazlar)
MISTRAL_API_KEY=
CEREBRAS_API_KEY=

#  Anthropic Claude — ÜCRETLİ. AI_PROVIDERS'a "claude" eklenmedikçe
#  kullanılmaz. CLAUDE_API_KEY yerine ANTHROPIC_API_KEY de olur.
#  https://console.anthropic.com
CLAUDE_API_KEY=

#  Sağlayıcı başına en büyük istek (yaklaşık giriş token'ı). Bundan büyük
#  istek o sağlayıcıya gönderilmez, sıradakine geçilir; uzun videonun raporu
#  gerekirse gruplar hâlinde (kademeli) birleştirilir. Boşsa modülün config.php
#  değeri (groq 7000 — ücretsiz katman dakikada 8000 token —, evren 200000 …).
# GROQ_MAX_INPUT_TOKENS=
# EVREN_MAX_INPUT_TOKENS=

#  Modeller: Transkript ayarları → Yapay zekâ sekmesinden seçilir (zincirdeki
#  her sağlayıcı için ayrı alan). Panel boşsa sırayla <AD>_MODEL, sonra
#  modülün varsayılanı. Aşama başı model modülün config.php dosyasında.
# OPENROUTER_MODEL=
# GROQ_MODEL=
# MISTRAL_MODEL=
# CEREBRAS_MODEL=

#  Tek sağlayıcılı eski düzen (AI_PROVIDERS boşsa yalnız AI_PROVIDER denenir;
#  ikisi de boşsa evren,gemini,openrouter,groq). AI_MODEL asıl sağlayıcının
#  modelidir; AI_API_KEY yalnız ilk sağlayıcıya gider.
# AI_MODEL=
# AI_MAX_TOKENS=4096
# AI_API_KEY=
#  İsteğe bağlı (boşsa yorumdaki varsayılan):
#  AI_BASE_URL: openai-compatible için taban adres (örn. https://api.x.ai/v1)
#  AI_EFFORT: Claude düşünme derinliği (low · medium · high · xhigh · max)
#  AI_THINKING: Gemini düşünme özeti (desteklemeyen modelde 400 verir)
# AI_BASE_URL=
# AI_EFFORT=medium
# AI_THINKING=false

# --- Transkript modülü: transcript zinciri ------------------------
#  TRANSCRIPT_PROVIDERS: sırayla denenen sağlayıcılar (satır yoksa youtube,gemini)
#    youtube  YouTube altyazısı, ücretsiz
#    gemini   Gemini'ye video URL'si; ÜCRETLİ, GEMINI_API_KEY ister
#    harici   ücretli transcript API (5c. aşama), TRANSCRIPT_API_KEY
#    asr      yalnız yüklenen dosya (5b. aşama), ASR_API_KEY
#  Önerilen: yalnız ücretsiz YouTube altyazısı. Altyazısız videolar için
#  gemini'yi ekleyin (maliyet oluşturur).
#  GEMINI_TRANSCRIPT_MODEL boşsa gemini-2.5-flash.
TRANSCRIPT_PROVIDERS=youtube
# GEMINI_TRANSCRIPT_MODEL=
TRANSCRIPT_API_KEY=
ASR_API_KEY=
